# DevAgent 环境配置示例
# 复制为 .env 并填入真实值

# ---------- 应用 ----------
DEVAGENT_ENV=development
DEVAGENT_LOG_LEVEL=INFO
DEVAGENT_API_HOST=0.0.0.0
DEVAGENT_API_PORT=8000

# ---------- 数据库 ----------
# 仅当 DEVAGENT_STORAGE__BACKEND=sql 时才会被使用
DEVAGENT_DATABASE__URL=postgresql+asyncpg://devagent:devagent@localhost:5432/devagent

# ---------- 任务存储 ----------
# memory（默认）：零依赖，进程重启即失；sql：持久化，需装 '.[db]' extra
DEVAGENT_STORAGE__BACKEND=memory
DEVAGENT_STORAGE__MEMORY_CAPACITY=200
DEVAGENT_STORAGE__EVENT_HISTORY_LIMIT=2000

# ---------- Redis ----------
DEVAGENT_REDIS__URL=redis://localhost:6379/0

# ---------- 模型提供商 ----------
# DeepSeek (https://platform.deepseek.com)
DEVAGENT_MODELS__DEEPSEEK__API_KEY=sk-xxxxxxxxxxxxxxxx
DEVAGENT_MODELS__DEEPSEEK__BASE_URL=https://api.deepseek.com/v1

# 通义千问 (阿里云 DashScope)
DEVAGENT_MODELS__QWEN__API_KEY=sk-xxxxxxxxxxxxxxxx
DEVAGENT_MODELS__QWEN__BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 智谱 GLM
DEVAGENT_MODELS__ZHIPU__API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxx
DEVAGENT_MODELS__ZHIPU__BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---------- 模型分级路由 ----------
# 必须是 '<provider>:<model>' 形式（RoutingConfig 的校验器会拒绝裸模型名，
# 缺冒号会直接抛 ValidationError，整个应用起不来）。
DEVAGENT_ROUTING__SMALL_MODEL=qwen:qwen-turbo
DEVAGENT_ROUTING__MEDIUM_MODEL=deepseek:deepseek-chat
DEVAGENT_ROUTING__LARGE_MODEL=deepseek:deepseek-reasoner
DEVAGENT_ROUTING__EMBEDDING_MODEL=qwen:text-embedding-v3

# ---------- 模型响应缓存 ----------
DEVAGENT_CACHE__ENABLED=true
# semantic=true 启用向量检索（需要嵌入模型可用，且每次未命中多一次嵌入调用）
DEVAGENT_CACHE__SEMANTIC=false
DEVAGENT_CACHE__SIMILARITY_THRESHOLD=0.92
DEVAGENT_CACHE__MAX_ENTRIES=512
DEVAGENT_CACHE__MODEL_FILTER=true

# ---------- 评测（LLM-as-Judge） ----------
# 主裁判：产出实际评分。双向评估与交换位置用于对冲位置偏差。
DEVAGENT_EVALUATION__JUDGE_MODEL=deepseek:deepseek-chat
DEVAGENT_EVALUATION__ENABLE_BIDIRECTIONAL_JUDGE=true
# 异构参考裁判：必须与主裁判**不同模型族**，否则标定偏差恒为 0（自己减自己），
# 工厂会拒绝该配置并打 reference_judge_same_family 警告。
# 作用：标定主裁判的自我偏好偏差（候选与主裁判同族时尤为必要）。
DEVAGENT_EVALUATION__REFERENCE_JUDGE_MODEL=qwen:qwen-plus
# 标定用样本数上限；0 = 全部。低于 20 时标定判为不可靠，不用于校正。
DEVAGENT_EVALUATION__CALIBRATION_SAMPLE_LIMIT=0
DEVAGENT_EVALUATION__GOLDEN_SET_PATH=datasets/golden_set.jsonl
DEVAGENT_EVALUATION__REPORT_DIR=reports/eval

# ---------- 上下文工程 ----------
# 各角色的 token 预算上限
DEVAGENT_CONTEXT__DEFAULT_BUDGET=16000
DEVAGENT_CONTEXT__COMPRESSION_THRESHOLD=0.7
DEVAGENT_CONTEXT__HARD_CONSTRAINT_UNTOUCHABLE=true
# 提示词注入防护：给不可信来源（仓库文件/命令回显/检索结果）的上下文
# 加带随机 nonce 的内容边界，并把来源可信度计入装配打分。
# 关闭后行为与升级前完全一致（用于对比实验与"我就是要塞原始内容"的场景）。
DEVAGENT_CONTEXT__INJECTION_GUARD=true
# 信任度在装配打分中的权重；0 = 关闭信任度影响（渲染层边界仍生效）
DEVAGENT_CONTEXT__WEIGHT_TRUST=1.0

# ---------- 可靠性 ----------
DEVAGENT_RELIABILITY__MAX_RETRIES=3
DEVAGENT_RELIABILITY__MAX_TASK_TOKENS=500000
DEVAGENT_RELIABILITY__MAX_TASK_STEPS=50

# ---------- 沙箱 ----------
DEVAGENT_SANDBOX__ENABLED=true
DEVAGENT_SANDBOX__IMAGE=devagent/sandbox:latest
DEVAGENT_SANDBOX__TIMEOUT_SECONDS=60
DEVAGENT_SANDBOX__MEMORY_LIMIT=512m
DEVAGENT_SANDBOX__CPU_LIMIT=1.0
DEVAGENT_SANDBOX__NETWORK_DISABLED=true

# ---------- 可观测性 ----------
DEVAGENT_OBSERVABILITY__TRACING_ENABLED=true
DEVAGENT_OBSERVABILITY__OTLP_ENDPOINT=
